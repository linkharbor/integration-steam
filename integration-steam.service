# systemd unit — copy to /etc/systemd/system/integration-steam.service,
# put the two secrets into /etc/integration-steam.env (chmod 600):
#   LH_INGEST_URL=https://dock.at-harbor.com/v1/ingest/123
#   LH_INGEST_SECRET=…
[Unit]
Description=LinkHarbor Steam/Source server agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/integration-steam.env
ExecStart=/usr/bin/python3 /opt/integration-steam/agent.py --host 127.0.0.1 --port 27015 --name "My Server" --address "play.example.com:27015" --url "https://discord.gg/xyz"
Restart=always
RestartSec=10
User=nobody

[Install]
WantedBy=multi-user.target
